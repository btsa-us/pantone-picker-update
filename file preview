  }
  var dragging=false;
  rail.addEventListener("mousedown",function(e){ dragging=true; seek(e); e.preventDefault(); });
  window.addEventListener("mousemove",function(e){ if(dragging) seek(e); });
  window.addEventListener("mouseup",function(){ dragging=false; });
  rail.addEventListener("touchstart",function(e){ seek(e); },{passive:true});
  rail.addEventListener("touchmove",function(e){ seek(e); },{passive:true});

  // ── Photo eyedropper ───────────────────────────────────────────────────
  dzel.addEventListener("click",function(){ fiel.click(); });
  dzel.addEventListener("dragover",function(e){ e.preventDefault(); dzel.classList.add("over"); });
  dzel.addEventListener("dragleave",function(){ dzel.classList.remove("over"); });
  dzel.addEventListener("drop",function(e){
    e.preventDefault(); dzel.classList.remove("over");
    if(e.dataTransfer.files[0]) loadPhoto(e.dataTransfer.files[0]);
  });
  fiel.addEventListener("change",function(){
    if(fiel.files && fiel.files[0]) loadPhoto(fiel.files[0]);
  });

  function loadPhoto(file){
    if(!file || !file.type.indexOf) return;
    if(file.type.indexOf("image/")!==0) return;
    var reader=new FileReader();
    reader.onload=function(ev){
      var img=new Image();
      img.onload=function(){
        natW=img.naturalWidth; natH=img.naturalHeight;
        imgcel.width=natW; imgcel.height=natH;
        ictx.drawImage(img,0,0);
        dzel.style.display="none";
        cwel.style.display="block";
        newphoto.style.display="block";
        searchwrap.style.display="none";
        gridzone.style.display="none";
      };
      img.src=ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function resetPhoto(){
    dzel.style.display="block";
    cwel.style.display="none";
    palrowel.style.display="none";
    newphoto.style.display="none";
    resultwrap.style.display="none";
    footer.style.display="none";
    loupeel.style.display="none";
    natW=0; natH=0; palette=[]; currentMatch=null; currentRows=[];
    matchesEl.innerHTML="";
    paldotsel.innerHTML="";
    fiel.value="";
    searchwrap.style.display="block";
    gridzone.style.display="flex";
    update();
  }

  function getXY(e){
    var rect=imgcel.getBoundingClientRect();
    var x=Math.round((e.clientX-rect.left)*(natW/rect.width));
    var y=Math.round((e.clientY-rect.top)*(natH/rect.height));
    return [Math.max(0,Math.min(x,natW-1)), Math.max(0,Math.min(y,natH-1))];
  }

  cwel.addEventListener("mousemove",function(e){
    if(!natW) return;
    var xy=getXY(e), x=xy[0], y=xy[1];
    var wr=cwel.getBoundingClientRect();
    var mx=e.clientX-wr.left, my=e.clientY-wr.top;
    var s=72, off=10, lx=mx+off, ly=my-s-off;
    if(ly<0) ly=my+off;
    if(lx+s>wr.width) lx=mx-s-off;
    loupeel.style.left=lx+"px";
    loupeel.style.top=ly+"px";
    loupeel.style.display="block";
    lctx.clearRect(0,0,s,s);
    lctx.imageSmoothingEnabled=false;
    lctx.drawImage(imgcel, Math.max(0,x-5), Math.max(0,y-5), 10, 10, 0, 0, s, s);
  });
  cwel.addEventListener("mouseleave",function(){ loupeel.style.display="none"; });

  cwel.addEventListener("click",function(e){
    if(!natW) return;
    var xy=getXY(e);
    var px=ictx.getImageData(xy[0],xy[1],1,1).data;
    var hex=toHex(px[0],px[1],px[2]);
    var matches=closestN(px[0],px[1],px[2],3);
    showMatches(hex, matches);
    addDot(hex, matches);
  });

  function showMatches(pickedHex, matches){
    currentRows=matches;
    currentMatch=matches[0];
    resultwrap.style.display="block";
    pickedSw.style.background=pickedHex;
    matchesEl.innerHTML="";

    matches.forEach(function(m,i){
      var c=m.entry;
      var row=document.createElement("div");
      row.className="mrow"+(i===0?" sel":"");

      var sw=document.createElement("div");
      sw.className="sw";
      sw.style.background=c.hex;

      var body=document.createElement("div");
      var nm=document.createElement("div");
      nm.className="nm";
      nm.textContent=c.name;
      if(i===0){
        var tag=document.createElement("span");
        tag.className="tag";
        tag.textContent="Best match";
        nm.appendChild(tag);
      }
      var cd=document.createElement("div");
      cd.className="cd";
      cd.textContent=c.code;
      var sig=document.createElement("div");
      sig.className="sig";
      sig.innerHTML=pctMatch(m.deltaE)+"% &nbsp;·&nbsp; ΔE "+m.deltaE.toFixed(1);

      body.appendChild(nm); body.appendChild(cd); body.appendChild(sig);
      row.appendChild(sw); row.appendChild(body);

      row.addEventListener("click",function(){
        var rows=matchesEl.children;
        for(var k=0;k<rows.length;k++) rows[k].classList.remove("sel");
        row.classList.add("sel");
        currentMatch=m;
      });

      matchesEl.appendChild(row);
    });

    footer.style.display="flex";
  }

  function addDot(h,matches){
    if(palette.indexOf(h)!==-1){ highlightDot(h); return; }
    if(palette.length>=8){
      palette.shift();
      if(paldotsel.firstChild) paldotsel.removeChild(paldotsel.firstChild);
    }
    palette.push(h);
    var dot=document.createElement("div");
    dot.className="pdot";
    dot.style.background=h;
    dot.title=h;
    dot.dataset.hex=h;
    dot.addEventListener("click",function(){ showMatches(h, matches); highlightDot(h); });
    paldotsel.appendChild(dot);
    palrowel.style.display="flex";
    highlightDot(h);
  }

  function highlightDot(h){
    var dots=document.querySelectorAll(".pdot");
    for(var i=0;i<dots.length;i++){
      dots[i].classList.toggle("pactive", dots[i].dataset.hex===h);
    }
  }

  // Apply returns to the grid with the matched Pantone selected and scrolled
  // into view, so the photo path and the browse path end in the same place.
  document.getElementById("btn-apply").addEventListener("click",function(){
    var m=currentMatch;
    resetPhoto();
    if(!m) return;
    render(LIB);
    var cell=swgrid.children[m.index];
    if(cell){
      if(selectedCell) selectedCell.classList.remove("sel");
      cell.classList.add("sel");
      selectedCell=cell;
      scroller.scrollTop = Math.max(0, cell.offsetTop - scroller.clientHeight/2);
    }
    update();
  });

  document.getElementById("btn-close").addEventListener("click",resetPhoto);
  document.getElementById("newPhotoBtn").addEventListener("click",resetPhoto);

  document.getElementById("clearBtn").addEventListener("click",function(){
    q.value="";
    render(LIB);
    scroller.scrollTop=0;
    resetPhoto();
  });

  update();
})();
</script>
</body>
</html>
