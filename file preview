    rail.style.opacity = list.length===LIB.length ? "1" : ".2";

    var frag=document.createDocumentFragment();
    list.forEach(function(c){
      var d=document.createElement("div");
      d.style.background=c.hex;
      d.dataset.code=c.code;
      d.addEventListener("mouseenter",function(){
        floatlbl.innerHTML=c.name+'<br><span class="c">'+c.code+'</span>';
        floatlbl.style.opacity="1";
      });
      d.addEventListener("mousemove",function(ev){
        floatlbl.style.left=(ev.clientX-floatlbl.offsetWidth-16)+"px";
        floatlbl.style.top=(ev.clientY+16)+"px";
      });
      d.addEventListener("mouseleave",function(){ floatlbl.style.opacity="0"; });
      d.addEventListener("click",function(){
        if(selectedCell) selectedCell.classList.remove("sel");
        d.classList.add("sel");
        selectedCell=d;
      });
      frag.appendChild(d);
    });
