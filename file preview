  function toHex(r,g,b){
    function h(v){ var s=Math.round(v).toString(16); return s.length===1?"0"+s:s; }
    return ("#"+h(r)+h(g)+h(b)).toUpperCase();
  }

  function rgb2lab(r,g,b){
    var R=r/255,G=g/255,B=b/255;
    R=R>0.04045?Math.pow((R+0.055)/1.055,2.4):R/12.92;
    G=G>0.04045?Math.pow((G+0.055)/1.055,2.4):G/12.92;
    B=B>0.04045?Math.pow((B+0.055)/1.055,2.4):B/12.92;
    var X=(R*0.4124+G*0.3576+B*0.1805)/0.95047;
    var Y= R*0.2126+G*0.7152+B*0.0722;
    var Z=(R*0.0193+G*0.1192+B*0.9505)/1.08883;
    function f(v){ return v>0.008856?Math.pow(v,1/3):7.787*v+16/116; }
    return [116*f(Y)-16, 500*(f(X)-f(Y)), 200*(f(Y)-f(Z))];
  }

  var labCache = LIB.map(function(c){ return rgb2lab(c.rgb[0],c.rgb[1],c.rgb[2]); });

  // Returns the n closest library colors, nearest first.
  function closestN(r,g,b,n){
    var L=rgb2lab(r,g,b), out=[];
    for(var i=0;i<labCache.length;i++){
      var l=labCache[i];
      var d=(L[0]-l[0])*(L[0]-l[0])+(L[1]-l[1])*(L[1]-l[1])+(L[2]-l[2])*(L[2]-l[2]);
      out.push({ index:i, d:d });
    }
    out.sort(function(a,b){ return a.d-b.d; });
    return out.slice(0,n).map(function(o){
      return { entry:LIB[o.index], index:o.index, deltaE:Math.sqrt(o.d) };
    });
  }

