<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pick a Pantone — panel</title>
<style>
  :root{
    --ink:#141414;
    --line:#e4e2dc;
    --muted:#8a857a;
    --panel-w:470px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;height:100%;}
  body{
    font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
    color:var(--ink);background:#f0efec;
    display:flex;justify-content:flex-end;overflow:hidden;
  }

  .panel{
    width:var(--panel-w);height:100%;background:#fff;
    border-left:1px solid var(--line);
    display:flex;flex-direction:column;
  }

  .phead{
    display:flex;align-items:center;justify-content:space-between;
    padding:20px 24px;border-bottom:1px solid var(--line);flex:0 0 auto;
  }
  .phead .title{font-size:16px;}
  .phead .clear{font-size:15px;color:var(--ink);background:none;border:none;padding:0;cursor:pointer;font-family:inherit;}
  .phead .clear:hover{color:var(--muted);}

  .searchwrap{padding:20px 24px 0;flex:0 0 auto;}
  .search{display:flex;align-items:center;gap:12px;border:1px solid var(--ink);padding:13px 15px;}
  .search input{flex:1;border:none;outline:none;background:none;font-family:inherit;font-size:15px;color:var(--ink);}
  .search input::placeholder{color:var(--muted);}
  .search svg{flex:0 0 17px;}

  .dz{
    margin:18px 24px 20px;border:1px dashed #c9c6bd;
    padding:30px 18px;text-align:center;flex:0 0 auto;cursor:pointer;
    transition:border-color .15s,background .15s;
  }
  .dz:hover{border-color:#8a857a;background:#fafaf8;}
  .dz.over{border-color:var(--ink);background:#f5f4f0;}
  .dz .icon{color:var(--muted);}
  .dz .l1{font-size:15px;margin-top:10px;}
  .dz .l2{font-size:13px;color:var(--muted);margin-top:6px;}

  #canvaswrap{position:relative;margin:0 24px;flex:0 0 auto;display:none;}
  #imgc{display:block;width:100%;height:auto;cursor:crosshair;border:1px solid var(--line);}
  #loupe{position:absolute;width:72px;height:72px;border-radius:50%;border:2px solid rgba(255,255,255,.9);box-shadow:0 0 0 1px rgba(0,0,0,.2);pointer-events:none;display:none;overflow:hidden;z-index:10;}
  #lxhair{position:absolute;top:50%;left:50%;width:8px;height:8px;transform:translate(-50%,-50%);pointer-events:none;}
  #lxhair::before,#lxhair::after{content:'';position:absolute;background:rgba(255,255,255,.85);}
  #lxhair::before{width:1px;height:100%;left:50%;transform:translateX(-50%);}
  #lxhair::after{height:1px;width:100%;top:50%;transform:translateY(-50%);}

  #newphoto{display:none;text-align:right;padding:6px 24px 0;}
  #newphoto button{font-size:12px;color:var(--muted);cursor:pointer;background:none;border:none;font-family:inherit;text-decoration:underline;text-underline-offset:2px;padding:0;}

  #palrow{display:none;flex-direction:row;flex-wrap:wrap;align-items:center;gap:7px;margin:10px 24px 0;}
  #paldots{display:flex;flex-direction:row;flex-wrap:wrap;gap:7px;align-items:center;}
  .plbl{font-size:11px;color:#b3aea3;letter-spacing:.05em;text-transform:uppercase;flex-shrink:0;}
  .pdot{width:22px;height:22px;border-radius:50%;border:1px solid var(--line);cursor:pointer;flex-shrink:0;transition:transform .1s;}
  .pdot:hover{transform:scale(1.2);}
  .pdot.pactive{box-shadow:0 0 0 2px var(--ink);}

  #resultwrap{display:none;margin:12px 24px 0;flex:0 0 auto;}

  #picked{display:flex;align-items:center;gap:14px;border:1px solid var(--line);padding:12px 14px;}
  #picked-sw{width:46px;height:46px;flex:0 0 46px;border:1px solid rgba(0,0,0,.08);}
  .plabel{font-size:11px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;}

  .mhead{font-size:11px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;margin:16px 0 8px;}
  .mrow{
    display:flex;align-items:center;gap:14px;
    border:1px solid var(--line);padding:12px 14px;margin-bottom:8px;cursor:pointer;
  }
  .mrow:hover{border-color:var(--muted);}
  .mrow.sel{border:2px solid var(--ink);padding:11px 13px;}
  .mrow .sw{width:46px;height:46px;flex:0 0 46px;border:1px solid rgba(0,0,0,.08);}
  .mrow .nm{font-size:15px;}
  .mrow .tag{font-size:10px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;margin-left:7px;}
  .mrow .cd{font-size:15px;}
  .mrow .sig{font-size:13px;color:var(--muted);font-style:italic;margin-top:3px;}

  #dtmlink{
    display:block;font-size:13px;color:var(--ink);
    text-decoration:underline;text-underline-offset:2px;
    margin:2px 0 16px;
  }

  #photo-footer{display:none;flex-direction:column;margin-top:auto;border-top:1px solid var(--line);flex:0 0 auto;}
  #btn-apply{width:100%;padding:16px;background:var(--ink);color:#fff;font-family:inherit;font-size:15px;border:none;cursor:pointer;}
  #btn-apply:hover{background:#333;}
  #btn-close{width:100%;padding:14px;background:#fff;color:var(--ink);font-family:inherit;font-size:15px;border:none;border-top:1px solid var(--line);cursor:pointer;}
  #btn-close:hover{background:#fafaf8;}

  .gridzone{
    flex:1;min-height:0;display:flex;
    border-top:1px solid var(--line);
    padding:14px 14px 14px 24px;gap:12px;
  }
  .scroller{flex:1;overflow-y:auto;padding-right:8px;}
  .swgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;}
  .swgrid div{aspect-ratio:1;cursor:pointer;}
  .swgrid div:hover{outline:2px solid var(--ink);outline-offset:-2px;}
  .swgrid div.sel{outline:3px solid var(--ink);outline-offset:-3px;}
  .rail{position:relative;width:22px;flex:0 0 22px;cursor:pointer;}
  .thumb{position:absolute;left:-3px;width:28px;height:4px;background:var(--ink);top:0;pointer-events:none;}

  .empty{grid-column:1 / -1;padding:30px 2px;font-size:14px;color:var(--muted);}

  .floatlbl{
    position:fixed;pointer-events:none;background:var(--ink);color:#fff;
    font-size:12px;line-height:1.45;padding:7px 10px;opacity:0;
    transition:opacity .12s ease;z-index:20;white-space:nowrap;
  }
  .floatlbl .c{color:#b9b5ac;}

  :focus-visible{outline:2px solid var(--ink);outline-offset:2px;}

  @media (max-width:520px){
    :root{--panel-w:100%;}
    body{background:#fff;}
    .panel{border-left:none;}
    .dz{padding:20px 14px;}
  }
  @media (prefers-reduced-motion:reduce){.floatlbl{transition:none;}}
</style>
</head>
<body>

<aside class="panel">

  <div class="phead">
    <span class="title">Pick a Color</span>
    <button class="clear" id="clearBtn">Clear</button>
  </div>

  <div class="searchwrap" id="searchwrap">
    <label class="search">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#8a857a" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
      <input id="q" type="search" placeholder="Search a color name or TCX code" aria-label="Search a color name or TCX code">
    </label>
  </div>

  <div class="dz" id="dz">
    <div class="icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16"/><circle cx="8.5" cy="9.5" r="1.7"/><path d="M3 17l5-5 4 4 3-3 6 6"/></svg>
    </div>
    <div class="l1">Drag a photo here or <u>upload a file</u></div>
    <div class="l2">Click any color to find its closest Pantone match</div>
    <input type="file" id="fi" accept="image/*" hidden>
  </div>

  <div id="canvaswrap">
    <canvas id="imgc"></canvas>
    <div id="loupe"><canvas id="lc" width="72" height="72"></canvas><div id="lxhair"></div></div>
  </div>

  <div id="newphoto"><button type="button" id="newPhotoBtn">Use a different photo</button></div>

  <div id="palrow"><span class="plbl">Saved</span><div id="paldots"></div></div>

  <div id="resultwrap">
    <div id="picked">
      <div id="picked-sw"></div>
      <div class="plabel">Picked color</div>
    </div>

    <div class="mhead">Closest Pantone TCX matches</div>
    <div id="matches"></div>

    <!-- TODO: swap in the real URL once the standalone DTM page is live -->
    <a id="dtmlink" href="/dye-to-match" target="_blank" rel="noopener">Open the full Dye-to-Match tool</a>
  </div>

  <div id="photo-footer">
    <button id="btn-apply">Apply</button>
    <button id="btn-close">Close</button>
  </div>

  <div class="gridzone" id="gridzone">
    <div class="scroller" id="scroller"><div class="swgrid" id="swgrid"></div></div>
    <div class="rail" id="rail"><div class="thumb" id="thumb"></div></div>
  </div>

</aside>

<div class="floatlbl" id="floatlbl"></div>

